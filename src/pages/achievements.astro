---
import MainLayout from "../layouts/MainLayouts.astro";

import { createClient } from "../lib/supabase";

const supabase = createClient({
  request: Astro.request,
  cookies: Astro.cookies,
});

const {
  data: { user },
} = await supabase.auth.getUser();

if (!user) {
  return Astro.redirect("/login");
}

const { data: achievements } = await supabase
  .from("achievements")
  .select("*")
  .order("xp_reward", { ascending: true });

const { data: unlocked } = await supabase
  .from("user_achievements")
  .select("achievement_id, unlocked_at")
  .eq("user_id", user.id);

const unlockedIds = new Set(
  (unlocked ?? []).map((item) => item.achievement_id)
);
---

<MainLayout title="Achievements | PLAYDAY" noIndex>

  <section class="section">

    <div class="container">

      <p class="eyebrow">A LITTLE CELEBRATION</p>

      <h1>Your achievements. ✨</h1>

      <p>
        Every little win deserves a celebration.
      </p>

      <div class="achievement-grid">

        {achievements?.map((achievement) => {

          const isUnlocked = unlockedIds.has(achievement.id);

          return (

            <article
              class:list={[
                "card",
                "achievement-card",
                { "is-locked": !isUnlocked }
              ]}
            >

              <img
                src={achievement.icon_path || "/icons/trophy.svg"}
                alt=""
                width="64"
                height="64"
                loading="lazy"
              />

              <h3>{achievement.name}</h3>

              <p>{achievement.description}</p>

              {isUnlocked ? (

                <span class="badge-unlocked">
                  Unlocked ♡
                </span>

              ) : (

                <span class="badge-locked">
                  Not yet unlocked
                </span>

              )}

            </article>

          );

        })}

      </div>

    </div>

  </section>

</MainLayout>
<style>
    .achievement-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 35px;
}

.achievement-card {
  padding: 25px;
  text-align: center;
}

.achievement-card.is-locked {
  opacity: 0.55;
  filter: grayscale(0.7);
}

.achievement-card img {
  margin: 0 auto 15px;
}

.badge-unlocked,
.badge-locked {
  display: inline-block;
  padding: 7px 13px;
  margin-top: 12px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.badge-unlocked {
  background: var(--color-blush);
  color: var(--color-cherry);
}

.badge-locked {
  background: #F4F0EE;
  color: var(--color-muted);
}
</style>